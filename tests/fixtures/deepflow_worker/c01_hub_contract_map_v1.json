    },
    "resource_lease": {
      "model": "ResourceLease",
      "fields": [
        "lease_group_id",
        "resource_key",
        "resource_type",
        "active_slot",
        "owner_type",
        "owner_id",
        "controller_run_id",
        "status",
        "ttl_seconds",
        "idempotency_key",
        "request_hash",
        "heartbeat_at",
        "expires_at",
        "released_at"
      ],
      "active_exclusion": "active_slot_unique"
    }
  },
  "gaps": [
    {
      "id": "H01_AGENT_DIRECT_ADMISSION",
      "status": "open",
      "summary": "agent_task lacks an atomic claim/admission path for capacity and waiting reasons; the existing claim endpoint intentionally accepts only worker_task"
    },
    {
      "id": "H02_AGENT_DIRECT_FENCING",
      "status": "open",
      "summary": "agent_task result and progress writes do not require the WorkflowRunStep fencing token"
    },
    {
      "id": "H02_RUN_RECONCILIATION",
      "status": "partial",
      "summary": "step heartbeat health and bounded timeout exist, but durable Run-to-Worker result reconciliation is not represented by one authoritative receipt"
    },
    {
      "id": "W02_DIRECT_OPERATION_JOURNAL",
      "status": "open",
      "summary": "agent_direct runs sidecar_v2, so codex_worker_v4 WorkerStateStore does not provide its production operation journal"
    },
    {
      "id": "H03_ATTACHMENT_IDEMPOTENCY",
      "status": "deferred_m2",
      "summary": "the Hub attachment upload route does not persist an idempotency key or content hash even though the Worker publisher sends an idempotency key"
    }
  ]
}
