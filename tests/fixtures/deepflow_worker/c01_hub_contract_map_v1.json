  "deepflow_contract": {
    "schema": "deepflow.racinggo.operations@1",
    "contract_sha256": "22391264b5279ff8c6cc8b1bd87dac70253e0b8252965942fa621a0ebb1e52b0",
    "source": "DeepFlow_Hub_Worker_Incremental_r3_2026-09-08/configs/contracts/racinggo_operations_v1.json",
    "production_release": false
  },
  "routes": {
    "run_create": {
      "path": "/api/v1/workflow-runs",
      "methods": ["POST"],
      "authority": "hub"
    },
    "step_claim": {
      "path": "/api/v1/workflow-runs/<int:run_id>/steps/<step_id>/claim",
      "methods": ["POST"],
      "authority": "hub",
      "supported_step_types": ["worker_task"]
    },
    "step_heartbeat": {
      "path": "/api/v1/workflow-runs/<int:run_id>/steps/<step_id>/heartbeat",
      "methods": ["POST"],
      "authority": "hub"
    },
    "step_result": {
      "path": "/api/v1/workflow-runs/<int:run_id>/steps/<step_id>/result",
      "methods": ["POST"],
      "authority": "hub",
      "idempotency": "actor_and_idempotency_key",
      "fencing_required_for_step_types": ["worker_task"]
    },
    "resource_lease_acquire": {
      "path": "/api/v1/resource-leases/acquire",
      "methods": ["POST"],
      "authority": "hub"
    }
  },
  "models": {
    "run_binding": {
      "model": "WorkflowRun",
      "fields": [
        "id",
        "definition_id",
        "project_id",
        "idempotency_key",
        "idempotency_request_hash",
        "controller_run_id",
        "correlation_id",
        "trigger_source",
        "context_json",
        "business_conclusion",
        "automation_conclusion",
        "evidence_ingest_status",
        "outcomes_json"
      ],
      "snapshot_paths": [
        "context_json.workflow_definition_snapshot",
        "context_json.assignment_snapshot",
        "context_json.execution_input_snapshot",
        "context_json.testcase_library_snapshot"
      ]
    },
    "step_execution": {
      "model": "WorkflowRunStep",
      "fields": [
        "run_id",
        "step_id",
        "step_type",
        "attempt_no",
        "status",
        "step_config_json",
        "claimed_by",
        "claimed_claw_id",
        "claim_expires_at",
        "claim_lease_seconds",
        "claim_fencing_token",
        "heartbeat_at",
        "progress_json",
        "outputs_json",
        "metrics_json",
        "evidence_json",
        "logs_json",
        "blocker_json",
        "contract_result_json"
      ]
    },
    "write_idempotency": {
      "model": "WorkflowOperationIdempotency",
      "fields": [
        "actor_type",
        "actor_id",
        "idempotency_key",
        "method",
        "path",
        "request_hash",
        "response_status",
        "response_body_json",
        "expires_at"
      ],
