{
  "name": "openclaw-manager-sync",
  "version": "1.0.0",
  "display_name": "OpenClaw Manager 同步插件",
  "description": "连接 OpenClaw Manager，实现配置同步、任务接收和结果上报",
  "author": "OpenClaw Team",
  "homepage": "https://github.com/rajqiu2022/openclaw-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajqiu2022/openclaw-agent.git"
  },
  "entry_point": "python main.py",
  "working_directory": ".",
  "env": {
    "MANAGER_URL": "http://clawteam.woa.com:18800",
    "CLAW_ID": "4",
    "API_TOKEN": "oc_tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "OPENCLAW_DIR": "/root/.qclaw",
    "HEARTBEAT_INTERVAL": "30"
  },
  "capabilities": {
    "file_read": true,
    "file_write": true,
    "shell_execute": true,
    "config_modify": true
  },
  "events": [
    "task_received",
    "task_completed",
    "task_failed",
    "connected",
    "disconnected"
  ],
  "openclaw_version": ">= 0.9.0"
}
